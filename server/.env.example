# Server port (defaults to 3001 locally; Render sets PORT automatically)
PORT=3001

# Allowed frontend origins for CORS (comma-separated list; whitespace is trimmed automatically)
CLIENT_ORIGIN=http://localhost:5173,https://downloader.pxxlspace.cv

# Runtime environment: development | production | test
NODE_ENV=development

# Maximum time allowed for metadata extraction (in milliseconds)
EXTRACTION_TIMEOUT_MS=30000

# Maximum time allowed for media download streaming (in milliseconds)
DOWNLOAD_TIMEOUT_MS=120000

# Maximum allowed media file size in megabytes
MAX_DOWNLOAD_SIZE_MB=200

# Rate limit window duration in milliseconds (default: 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum number of API requests per IP within the rate limit window
RATE_LIMIT_MAX_REQUESTS=20

# Optional custom binary paths (leave blank to auto-detect from PATH / local environment)
YTDLP_PATH=
FFMPEG_PATH=
